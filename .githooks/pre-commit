#!/bin/sh
# Bloquea commits con archivos sensibles (revisión en check_secrets.py).
# Funciona igual en Linux y en Windows (Git Bash): en Windows "python3" suele ser un acceso
# directo falso de Microsoft Store, así que se prueba cada intérprete antes de usarlo.
dir=$(dirname "$0")
for py in python3 python py; do
    if "$py" -c "import sys" >/dev/null 2>&1; then
        exec "$py" "$dir/check_secrets.py"
    fi
done
echo "pre-commit: no se encontró Python; no se pudo revisar si hay archivos sensibles." >&2
echo "Instala Python o revisa el staging a mano y usa 'git commit --no-verify' bajo tu responsabilidad." >&2
exit 1
