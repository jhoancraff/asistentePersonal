# Copia este archivo a .env y completa los valores. .env NUNCA se sube a git.
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=True
# Para probar desde el teléfono añade la IP de tu PC (ipconfig) en ambas listas:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Ejemplo LAN: DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.X.X
#              CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.X.X:5173
TIME_ZONE=America/Bogota

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Web Push (python manage.py generar_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# Cifrado de notas seguras (python manage.py generar_clave_cifrado).
# Si pierdes esta clave, las notas cifradas NO se pueden recuperar: respáldala.
FIELD_ENCRYPTION_KEYS=

# Agente de IA. Groq: https://console.groq.com/keys  ·  Gemini: https://aistudio.google.com/apikey
IA_PROVEEDORES=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Voz de entrada (usa GROQ_API_KEY)
GROQ_STT_MODEL=whisper-large-v3-turbo
VOZ_IDIOMA=es

# Correos bancarios (ver README). Remitentes permitidos y verificación SPF/DKIM/DMARC.
# CORREO_REMITENTES_PERMITIDOS=no-reply@bancamiga.com
# CORREO_EXIGIR_AUTENTICACION=True

# ── SOLO PRODUCCIÓN (en desarrollo déjalas comentadas: los valores por defecto son seguros para local) ──
# Ver backend/DEPLOYMENT.md. Estas variables viven únicamente en el .env del servidor.
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.example
